					<ParticleSysBone
						BoneName="FX_FireBone"
						FXParticleSystemTemplate="SonicEmition_Spark"
						FollowBone="true" />
					<ParticleSysBone
						BoneName="FX_FireBone"
						FXParticleSystemTemplate="SonicEmition_Distort"
						FollowBone="true" />
				</AnimationState>
			</ScriptedModelDraw>

			<ScriptedModelDraw
				id="ModuleTag_HideSubObjects"
