<?xml version="1.0" encoding="us-ascii"?>
<AssetDeclaration xmlns="uri:ea.com:eala:asset">

	<WeaponTemplate
		id="GDIRifleSoldierRifleFake"
		Name="GDIRifleSoldierRifleFake"
		AttackRange="260.0"
		WeaponSpeed="999999.0"
		FireSoundPerClip=""
		FireFX=""
		FireVeteranFX=""
		RadiusDamageAffects="ALLIES ENEMIES NEUTRALS"
		ClipSize="3"
		AntiMask="ANTI_GROUND"
		AcceptableAimDelta="10d"
		CanFireWhileMoving="true"
		>
		<ClipReloadTime
				MinSeconds="99999s"
				MaxSeconds="99999s" />
		<Nuggets>
			<DamageNugget
				Damage="1.0"
				Radius="0.0"
				DelayTimeSeconds="0.0s"
				DamageType="GUN"
				DamageFXType="GDI_MACHINEGUN"
				DeathType="NORMAL">
			<DamageScalarDetails Scalar= "0%" />
			</DamageNugget>
		</Nuggets>
	</WeaponTemplate>

	<!-- phase field bug workaround-->

	<WeaponTemplate
		id="AlienPhaseFieldWeaponTrigger"
		Name="AlienPhaseFieldWeaponTrigger"
		RadiusDamageAffects="ALLIES"
		AttackRange="50000.0"
		>
		<!-- FireSound="ALI_PhaseGenerator_Begin" no worky -->
		<!-- FireFX="FX_ALI_PhaseGenerator_Begin" no worky -->
		<FiringDuration
			MinSeconds="0.1s"
			MaxSeconds="0.1s" />
		<Nuggets>
			<WeaponOCLNugget WeaponOCL="OCL_PhaseDummy" />
		</Nuggets>
	</WeaponTemplate>

	<WeaponTemplate
		id="AlienPhaseFieldWeapon"
		Name="AlienPhaseFieldWeapon"
		RadiusDamageAffects="ALLIES"
		AttackRange="50000.0"
		>
		<!-- FireSound="ALI_PhaseGenerator_Begin" no worky -->
		<!-- FireFX="FX_ALI_PhaseGenerator_Begin" no worky -->
		<Nuggets>
		<!-- spawn a dummy that fires a weapon on created 	-->

		<LuaEventNugget
			Radius="100.0"
			EventName="PhaseFieldEvent"
			SendToAllies="true"
		>
			<SpecialObjectFilter
					Relationship="ALLIES"
					Rule="ANY"
					Exclude="AIRCRAFT INFANTRY"
					Include="VEHICLE">
					<!-- MCVs are phaseable, including the scrin family unpacking objects for
					     the few seconds they are on the ground. keep in sync with the
					     ObjectFilter of SpecialPower_PhaseField in SpecialPowerTemplates.xml -->
					<IncludeThing>AlienMCV</IncludeThing>
					<IncludeThing>AlienMCVUnpacking</IncludeThing>
					<IncludeThing>Reaper17MCV</IncludeThing>
					<IncludeThing>Reaper17MCVUnpacking</IncludeThing>
					<IncludeThing>Traveler59MCV</IncludeThing>
					<IncludeThing>Traveler59MCVUnpacking</IncludeThing>
					<ExcludeThing>Viceroid</ExcludeThing>
				</SpecialObjectFilter>
		</LuaEventNugget>
		</Nuggets>
	</WeaponTemplate>


</AssetDeclaration>
